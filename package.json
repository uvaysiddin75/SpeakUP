{
  "name": "speakup",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node node_modules/prisma/build/index.js generate && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:push": "node node_modules/prisma/build/index.js db push",
    "db:migrate": "node node_modules/prisma/build/index.js migrate dev",
    "db:studio": "node node_modules/prisma/build/index.js studio",
    "db:check": "node node_modules/tsx/dist/cli.mjs --env-file=.env scripts/check-db.ts",
    "db:seed": "node node_modules/tsx/dist/cli.mjs --env-file=.env prisma/seed.ts",
    "db:stats": "node node_modules/tsx/dist/cli.mjs scripts/curriculum-stats.ts",
    "pg:start": "node node_modules/tsx/dist/cli.mjs scripts/pg.ts start",
    "pg:stop": "node node_modules/tsx/dist/cli.mjs scripts/pg.ts stop",
    "pg:status": "node node_modules/tsx/dist/cli.mjs scripts/pg.ts status",
    "postinstall": "node node_modules/prisma/build/index.js generate"
  },
  "prisma": {
    "seed": "node node_modules/tsx/dist/cli.mjs --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/client": "6.19.3",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "next": "16.3.5",
    "next-auth": "^5.0.0-beta.32",
    "next-intl": "^4.14.5",
    "next-themes": "^0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "6.19.3",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5"
  }
}
