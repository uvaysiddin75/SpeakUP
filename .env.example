# PostgreSQL connection string (required)
# Replace USER, PASSWORD, host, port, and database name with your values.
# Docker Compose default (port 5432):
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/speakup?schema=public"

# Auth.js / NextAuth
AUTH_SECRET="generate-a-long-random-secret"
AUTH_URL="http://localhost:3000"
AUTH_GITHUB_ID="your-github-oauth-app-client-id"
AUTH_GITHUB_SECRET="your-github-oauth-app-client-secret"

# Optional: path to a portable PostgreSQL install used by `npm run pg:start`
# SPEAKUP_PG_HOME="D:\\speakup-pg"
